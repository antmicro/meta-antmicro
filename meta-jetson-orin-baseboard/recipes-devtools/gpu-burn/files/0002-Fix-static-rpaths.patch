 Makefile | 2 --
 1 file changed, 2 deletions(-)

diff --git a/Makefile b/Makefile
index 8880583..11292f6 100644
--- a/Makefile
+++ b/Makefile
@@ -21,8 +21,6 @@ override LDFLAGS  += -L${CUDAPATH}/lib64
 override LDFLAGS  += -L${CUDAPATH}/lib64/stubs
 override LDFLAGS  += -L${CUDAPATH}/lib
